<mujoco model="cyberduck_v2_pro">
  <compiler angle="radian" meshdir="meshes" autolimits="true" />

  <option timestep="0.002" iterations="50" solver="PGS" gravity="0 0 -9.81"/>

  <visual>
    <global offwidth="1024" offheight="768" />
    <quality shadowsize="4096" />
    <map shadowclip="0.5" shadowscale="0.6" />
    <headlight ambient="0.45 0.47 0.50" diffuse="0.65 0.65 0.70" specular="0.25 0.25 0.25" />
  </visual>

  <default>
    <default class="cyberduck_v2">
      <joint frictionloss="0.1" armature="0.005" damping="0.05" />
      <default class="visual">
        <geom contype="0" conaffinity="0" group="2" />
      </default>
      <default class="collision">
        <geom group="3" contype="1" conaffinity="1" rgba="0.2 0.5 0.8 0" />
      </default>
    </default>
  </default>

  <asset>
    <!-- Materials with realistic PBR shine and emissive glow -->
    <!-- Giáp chính: Xám nhám (Matte Titanium Slate) -->
    <material name="mecha_white" rgba="0.34 0.36 0.40 1.0" specular="0.22" shininess="0.18" />
    <!-- Khung xương & Khớp nối: Đen Carbon nhám (Matte Carbon Fiber) -->
    <material name="mecha_carbon" rgba="0.15 0.16 0.18 1.0" specular="0.18" shininess="0.15" />
    <!-- Mỏ & Móng chân: Vàng đồng ánh kim (Burnished Metallic Bronze) -->
    <material name="mecha_gold" rgba="0.80 0.54 0.22 1.0" specular="0.75" shininess="0.70" />
    <material name="mecha_cyan_glow" rgba="0.0 0.92 1.0 1.0" specular="0.9" shininess="1.0" emission="0.85" />
    <material name="mecha_thruster" rgba="0.20 0.22 0.25 1.0" specular="0.25" shininess="0.20" />
    <material name="mecha_sole_rubber" rgba="0.12 0.13 0.15 1.0" specular="0.1" />

    <!-- Meshes -->
    <mesh name="cyber_helm" file="cyber_helm.stl" />
    <mesh name="cyber_visor" file="cyber_visor.stl" />
    <mesh name="cyber_beak" file="cyber_beak.stl" />
    <mesh name="cyber_neck" file="cyber_neck.stl" />
    <mesh name="cyber_chest" file="cyber_chest.stl" />
    <mesh name="cyber_reactor" file="cyber_reactor.stl" />
    <mesh name="cyber_thruster_pack" file="cyber_thruster_pack.stl" />
    <mesh name="cyber_hip_left" file="cyber_hip_left.stl" />
    <mesh name="cyber_hip_right" file="cyber_hip_right.stl" />
    <mesh name="cyber_thigh_left" file="cyber_thigh_left.stl" />
    <mesh name="cyber_thigh_right" file="cyber_thigh_right.stl" />
    <mesh name="cyber_shin_left" file="cyber_shin_left.stl" />
    <mesh name="cyber_shin_right" file="cyber_shin_right.stl" />
    <mesh name="cyber_foot_left" file="cyber_foot_left.stl" />
    <mesh name="cyber_foot_right" file="cyber_foot_right.stl" />
    <mesh name="cyber_sole_left" file="cyber_sole_left.stl" />
    <mesh name="cyber_sole_right" file="cyber_sole_right.stl" />

    <!-- Clean High-Tech Studio Environment -->
    <texture type="skybox" builtin="gradient" rgb1="0.28 0.34 0.44" rgb2="0.10 0.12 0.16" width="512" height="512" />
    <texture name="grid_floor" type="2d" builtin="checker" width="512" height="512" rgb1="0.20 0.24 0.30" rgb2="0.14 0.17 0.22" />
    <material name="floor_mat" texture="grid_floor" texrepeat="20 20" reflectance="0.12" />
  </asset>

  <worldbody>
    <light directional="true" diffuse="0.90 0.90 0.95" specular="0.3 0.3 0.3" pos="1.5 1.2 2.2" dir="-1.5 -1.2 -1.8" castshadow="true" />
    <light directional="true" diffuse="0.60 0.62 0.70" specular="0.2 0.2 0.2" pos="-1.5 -1.2 1.8" dir="1.5 1.2 -1.4" castshadow="false" />
    <light directional="false" diffuse="0.55 0.58 0.65" specular="0.1 0.1 0.1" pos="0 0 2.2" dir="0 0 -1" castshadow="false" />
    <light directional="true" diffuse="0.50 0.52 0.60" specular="0.1 0.1 0.1" pos="0.0 -1.8 1.0" dir="0.0 1.8 -0.6" castshadow="false" />
    <geom name="floor" type="plane" size="5 5 0.1" material="floor_mat" friction="1.0" />

    <!-- Slalom Pillars (3-layer course) -->
    <geom name="pillar_l1_left" type="cylinder" size="0.06 0.15" pos="0.45 0.35 0.15" rgba="0.8 0.2 0.2 1.0" contype="1" conaffinity="1"/>
    <geom name="pillar_l1_right" type="cylinder" size="0.06 0.15" pos="0.45 -0.35 0.15" rgba="0.8 0.2 0.2 1.0" contype="1" conaffinity="1"/>
    <geom name="pillar_l2_center" type="cylinder" size="0.07 0.15" pos="0.80 0.08 0.15" rgba="0.8 0.2 0.2 1.0" contype="1" conaffinity="1"/>
    <geom name="pillar_l3_left" type="cylinder" size="0.06 0.15" pos="1.15 0.25 0.15" rgba="0.8 0.2 0.2 1.0" contype="1" conaffinity="1"/>
    <geom name="pillar_l3_right" type="cylinder" size="0.06 0.15" pos="1.15 -0.25 0.15" rgba="0.8 0.2 0.2 1.0" contype="1" conaffinity="1"/>
    <geom name="pillar_back" type="cylinder" size="0.08 0.15" pos="-0.75 0.0 0.15" rgba="0.8 0.2 0.2 1.0" contype="1" conaffinity="1"/>

    <!-- Staircase & Landing Platform -->
    <geom name="stair_step_1" type="box" size="0.06 0.40 0.0075" pos="1.40 0.0 0.0075" rgba="0.4 0.6 0.7 1.0" friction="1.5 0.01 0.0005" contype="1" conaffinity="1" group="3"/>
    <geom name="stair_step_2" type="box" size="0.06 0.40 0.015" pos="1.52 0.0 0.015" rgba="0.4 0.6 0.7 1.0" friction="1.5 0.01 0.0005" contype="1" conaffinity="1" group="3"/>
    <geom name="stair_step_3" type="box" size="0.06 0.40 0.0225" pos="1.64 0.0 0.0225" rgba="0.4 0.6 0.7 1.0" friction="1.5 0.01 0.0005" contype="1" conaffinity="1" group="3"/>
    <geom name="stair_platform" type="box" size="0.16 0.40 0.0225" pos="1.86 0.0 0.0225" rgba="0.4 0.6 0.7 1.0" friction="1.5 0.01 0.0005" contype="1" conaffinity="1" group="3"/>
    <geom name="stair_dn_1" type="box" size="0.06 0.40 0.015" pos="2.08 0.0 0.015" rgba="0.4 0.6 0.7 1.0" friction="1.5 0.01 0.0005" contype="1" conaffinity="1" group="3"/>
    <geom name="stair_dn_2" type="box" size="0.06 0.40 0.0075" pos="2.20 0.0 0.0075" rgba="0.4 0.6 0.7 1.0" friction="1.5 0.01 0.0005" contype="1" conaffinity="1" group="3"/>
    <geom name="floor_exit" type="box" size="0.40 0.40 0.005" pos="2.66 0.0 0.005" rgba="0.3 0.5 0.6 1.0" friction="1.5 0.01 0.0005" contype="1" conaffinity="1" group="3"/>

    <!-- Main Torso Body -->
    <body name="trunk_base" pos="0 0 0.128" childclass="cyberduck_v2">
      <freejoint name="trunk_freejoint" />
      <inertial pos="0.002 0.000 -0.012" mass="0.36" diaginertia="0.00038 0.00048 0.00032" />
      <site name="imu" pos="0.016 0.012 0.006" size="0.003" rgba="1.0 0.4 0.0 0.95" group="2" />
      <site name="imu_site" pos="0.016 0.012 0.006" size="0.003" rgba="1.0 0.4 0.0 0.95" group="2" />

      <!-- Chest Armor, Reactor Core, Thruster Backpack -->
      <geom type="mesh" mesh="cyber_chest" material="mecha_white" class="visual" />
      <geom type="box" pos="0.005 0 0.001" size="0.033 0.046 0.038" class="collision" />
      <geom type="mesh" mesh="cyber_reactor" material="mecha_cyan_glow" class="visual" />
      <geom type="mesh" mesh="cyber_thruster_pack" material="mecha_thruster" class="visual" />
      <geom type="box" pos="-0.032 0 0.008" size="0.017 0.026 0.034" class="collision" />

      <!-- Neck & Head Assembly -->
      <body name="neck" pos="0.012 0 0.038">
        <joint name="head_yaw" type="hinge" axis="0 0 1" range="-1.57 1.57" />
        <inertial pos="0 0 0.008" mass="0.030" diaginertia="0.00001 0.00001 0.00001" />
        <geom type="mesh" mesh="cyber_neck" material="mecha_carbon" class="visual" />
        <geom type="capsule" fromto="0 0 0.004 0 0 0.020" size="0.012" class="collision" />

        <body name="head" pos="0 0 0.016">
          <joint name="head_pitch" type="hinge" axis="0 1 0" range="-0.52 0.78" />
          <inertial pos="0.015 0 0.018" mass="0.065" diaginertia="0.00007 0.00007 0.00006" />

          <!-- Aero Helm, Glowing Cyber Visor, Metallic Gold Beak -->
          <geom type="mesh" mesh="cyber_helm" material="mecha_white" class="visual" />
          <geom type="box" pos="0.002 0 0.017" size="0.028 0.028 0.022" class="collision" />
          <geom type="mesh" mesh="cyber_visor" material="mecha_cyan_glow" class="visual" />
          <geom type="mesh" mesh="cyber_beak" material="mecha_gold" class="visual" />
          <geom type="box" pos="0.037 0 0.003" size="0.020 0.016 0.006" class="collision" />
          <camera name="head_camera" pos="0.040 0 0.022" fovy="60" xyaxes="0 -1 0 0 0 1" />
          <site name="camera_site" pos="0.026 0 0.024" size="0.002" rgba="0.0 0.95 1.0 0.95" group="2" />

          <!-- 5-Ray ToF LiDAR Scanner: horizontal fan [-30°, -15°, 0°, +15°, +30°] mounted flush on visor brow -->
          <site name="site_lidar_m30" pos="0.024 0.010 0.022" zaxis="0.866025 -0.5 0" size="0.002" rgba="0.0 0.95 1.0 0.95" group="2"/>
          <site name="site_lidar_m15" pos="0.025 0.005 0.022" zaxis="0.965926 -0.258819 0" size="0.002" rgba="0.0 0.95 1.0 0.95" group="2"/>
          <site name="site_lidar_0" pos="0.026 0.000 0.022" zaxis="1 0 0" size="0.002" rgba="0.0 0.95 1.0 0.95" group="2"/>
          <site name="site_lidar_p15" pos="0.025 -0.005 0.022" zaxis="0.965926 0.258819 0" size="0.002" rgba="0.0 0.95 1.0 0.95" group="2"/>
          <site name="site_lidar_p30" pos="0.024 -0.010 0.022" zaxis="0.866025 0.5 0" size="0.002" rgba="0.0 0.95 1.0 0.95" group="2"/>
        </body>
      </body>

      <!-- Left Biped Leg -->
      <body name="left_hip" pos="0.005 0.036 -0.025">
        <joint name="left_hip_roll" type="hinge" axis="1 0 0" range="-0.44 0.44" />
        <inertial pos="0 0.008 -0.010" mass="0.05" diaginertia="0.00002 0.00002 0.00002" />
        <geom type="mesh" mesh="cyber_hip_left" material="mecha_carbon" class="visual" />
        <geom type="box" pos="0 0.004 -0.008" size="0.010 0.012 0.015" class="collision" />

        <body name="left_thigh" pos="0 0.012 -0.015">
          <joint name="left_hip_pitch" type="hinge" axis="0 1 0" range="-0.87 0.87" />
          <inertial pos="0.002 0 -0.020" mass="0.05" diaginertia="0.00003 0.00003 0.00002" />
          <geom type="mesh" mesh="cyber_thigh_left" material="mecha_white" class="visual" />
          <geom type="capsule" fromto="0.003 0 0.006 0.003 0 -0.028" size="0.011" class="collision" />

          <body name="left_shin" pos="0 0 -0.044">
            <joint name="left_knee_pitch" type="hinge" axis="0 1 0" range="0.0 1.48" />
            <inertial pos="0 0 -0.018" mass="0.04" diaginertia="0.00002 0.00002 0.00001" />
            <geom type="mesh" mesh="cyber_shin_left" material="mecha_carbon" class="visual" />
            <geom type="capsule" fromto="0.006 0 0.000 0.006 0 -0.030" size="0.010" class="collision" />

            <body name="left_foot" pos="0.004 0 -0.036">
              <inertial pos="0.005 0 0.006" mass="0.038" diaginertia="0.00002 0.00002 0.00002" />
              <site name="left_foot_touch_site" pos="0.005 0 -0.004" size="0.024 0.012 0.002" type="box" rgba="0.0 0.9 1.0 0.45" group="2" />
              <!-- 3-Claw Tactical Gold Foot & Rubber Tread Sole -->
              <geom type="mesh" mesh="cyber_foot_left" material="mecha_gold" class="visual" />
              <geom name="left_sole_geom" type="box" size="0.025 0.013 0.004" pos="0.005 0 -0.004" friction="1.5 0.01 0.0005" solref="0.005 1" solimp="0.9 0.95 0.001 0.5 2" class="collision" />
              <geom type="mesh" mesh="cyber_sole_left" material="mecha_sole_rubber" class="visual" />
            </body>
          </body>
        </body>
      </body>

      <!-- Right Biped Leg -->
      <body name="right_hip" pos="0.005 -0.036 -0.025">
        <joint name="right_hip_roll" type="hinge" axis="1 0 0" range="-0.44 0.44" />
        <inertial pos="0 -0.008 -0.010" mass="0.05" diaginertia="0.00002 0.00002 0.00002" />
        <geom type="mesh" mesh="cyber_hip_right" material="mecha_carbon" class="visual" />
        <geom type="box" pos="0 -0.004 -0.008" size="0.010 0.012 0.015" class="collision" />

        <body name="right_thigh" pos="0 -0.012 -0.015">
          <joint name="right_hip_pitch" type="hinge" axis="0 1 0" range="-0.87 0.87" />
          <inertial pos="0.002 0 -0.020" mass="0.05" diaginertia="0.00003 0.00003 0.00002" />
          <geom type="mesh" mesh="cyber_thigh_right" material="mecha_white" class="visual" />
          <geom type="capsule" fromto="0.003 0 0.006 0.003 0 -0.028" size="0.011" class="collision" />

          <body name="right_shin" pos="0 0 -0.044">
            <joint name="right_knee_pitch" type="hinge" axis="0 1 0" range="0.0 1.48" />
            <inertial pos="0 0 -0.018" mass="0.04" diaginertia="0.00002 0.00002 0.00001" />
            <geom type="mesh" mesh="cyber_shin_right" material="mecha_carbon" class="visual" />
            <geom type="capsule" fromto="0.006 0 0.000 0.006 0 -0.030" size="0.010" class="collision" />

            <body name="right_foot" pos="0.004 0 -0.036">
              <inertial pos="0.005 0 0.006" mass="0.038" diaginertia="0.00002 0.00002 0.00002" />
              <site name="right_foot_touch_site" pos="0.005 0 -0.004" size="0.024 0.012 0.002" type="box" rgba="0.0 0.9 1.0 0.45" group="2" />
              <!-- 3-Claw Tactical Gold Foot & Rubber Tread Sole -->
              <geom type="mesh" mesh="cyber_foot_right" material="mecha_gold" class="visual" />
              <geom name="right_sole_geom" type="box" size="0.025 0.013 0.004" pos="0.005 0 -0.004" friction="1.5 0.01 0.0005" solref="0.005 1" solimp="0.9 0.95 0.001 0.5 2" class="collision" />
              <geom type="mesh" mesh="cyber_sole_right" material="mecha_sole_rubber" class="visual" />
            </body>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <contact>
    <exclude body1="trunk_base" body2="neck"/>
    <exclude body1="neck" body2="head"/>
    <exclude body1="trunk_base" body2="left_hip"/>
    <exclude body1="left_hip" body2="left_thigh"/>
    <exclude body1="left_thigh" body2="left_shin"/>
    <exclude body1="left_shin" body2="left_foot"/>
    <exclude body1="trunk_base" body2="right_hip"/>
    <exclude body1="right_hip" body2="right_thigh"/>
    <exclude body1="right_thigh" body2="right_shin"/>
    <exclude body1="right_shin" body2="right_foot"/>
    <exclude body1="left_hip" body2="right_hip"/>
    <exclude body1="left_thigh" body2="right_thigh"/>
  </contact>

  <actuator>
    <motor name="head_yaw" joint="head_yaw" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="head_pitch" joint="head_pitch" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="left_hip_roll" joint="left_hip_roll" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="left_hip_pitch" joint="left_hip_pitch" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="left_knee_pitch" joint="left_knee_pitch" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="right_hip_roll" joint="right_hip_roll" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="right_hip_pitch" joint="right_hip_pitch" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="right_knee_pitch" joint="right_knee_pitch" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
  </actuator>

  <sensor>
    <accelerometer name="base_accel" site="imu" />
    <gyro name="base_gyro" site="imu" />
    <framequat name="base_quat" objtype="site" objname="imu" />
    <touch name="left_foot_touch" site="left_foot_touch_site" />
    <touch name="right_foot_touch" site="right_foot_touch_site" />
    <jointpos name="head_yaw_pos" joint="head_yaw" />
    <jointpos name="head_pitch_pos" joint="head_pitch" />
    <jointpos name="left_hip_roll_pos" joint="left_hip_roll" />
    <jointpos name="left_hip_pitch_pos" joint="left_hip_pitch" />
    <jointpos name="left_knee_pitch_pos" joint="left_knee_pitch" />
    <jointpos name="right_hip_roll_pos" joint="right_hip_roll" />
    <jointpos name="right_hip_pitch_pos" joint="right_hip_pitch" />
    <jointpos name="right_knee_pitch_pos" joint="right_knee_pitch" />
    <jointvel name="head_yaw_vel" joint="head_yaw" />
    <jointvel name="head_pitch_vel" joint="head_pitch" />
    <jointvel name="left_hip_roll_vel" joint="left_hip_roll" />
    <jointvel name="left_hip_pitch_vel" joint="left_hip_pitch" />
    <jointvel name="left_knee_pitch_vel" joint="left_knee_pitch" />
    <jointvel name="right_hip_roll_vel" joint="right_hip_roll" />
    <jointvel name="right_hip_pitch_vel" joint="right_hip_pitch" />
    <jointvel name="right_knee_pitch_vel" joint="right_knee_pitch" />

    <!-- 5-Ray LiDAR rangefinder sensors for Obstacle Navigation -->
    <rangefinder name="lidar_ray_m30" site="site_lidar_m30" cutoff="2.0"/>
    <rangefinder name="lidar_ray_m15" site="site_lidar_m15" cutoff="2.0"/>
    <rangefinder name="lidar_ray_0" site="site_lidar_0" cutoff="2.0"/>
    <rangefinder name="lidar_ray_p15" site="site_lidar_p15" cutoff="2.0"/>
    <rangefinder name="lidar_ray_p30" site="site_lidar_p30" cutoff="2.0"/>
  </sensor>
</mujoco>
