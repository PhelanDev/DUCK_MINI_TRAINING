<mujoco model="microduck_8dof">
  <compiler angle="radian" coordinate="local" inertiafromgeom="true"/>

  <option timestep="0.002" iterations="50" solver="PGS" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.15" armature="0.005" limited="true"/>
    <geom contype="1" conaffinity="1" condim="3"/>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2" density="0"/>
    </default>
    <default class="collision">
      <geom contype="1" conaffinity="1" group="3"/>
    </default>
    <default class="foot">
      <geom type="box" size="0.026 0.021 0.004" friction="1.5 0.01 0.0005" solref="0.005 1" solimp="0.9 0.95 0.001 0.5 2"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.1 0.15 0.2" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2"/>
    <material name="grid_mat" texture="grid" texrepeat="20 20" reflectance="0.2"/>
    <material name="duck_yellow" rgba="0.95 0.85 0.1 1.0" specular="0.3" shininess="0.5"/>
    <material name="duck_orange" rgba="1.0 0.5 0.05 1.0" specular="0.3" shininess="0.5"/>
    <material name="web_orange" rgba="0.95 0.45 0.05 0.95" specular="0.2" shininess="0.3"/>
    <material name="servo_grey" rgba="0.2 0.2 0.22 1.0" specular="0.4" shininess="0.7"/>
    <material name="white" rgba="0.95 0.95 0.95 1.0"/>
    <material name="black" rgba="0.05 0.05 0.05 1.0"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1" material="grid_mat" friction="1.5 0.01 0.0005"/>
    <light directional="true" pos="0 0 2" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2"/>
    <!-- Slalom Pillars (3-layer course) -->
    <geom name="pillar_l1_left" type="cylinder" size="0.06 0.15" pos="0.45 0.35 0.15" rgba="0.8 0.2 0.2 1.0" contype="1" conaffinity="1"/>
    <geom name="pillar_l1_right" type="cylinder" size="0.06 0.15" pos="0.45 -0.35 0.15" rgba="0.8 0.2 0.2 1.0" contype="1" conaffinity="1"/>
    <geom name="pillar_l2_center" type="cylinder" size="0.07 0.15" pos="0.80 0.08 0.15" rgba="0.8 0.2 0.2 1.0" contype="1" conaffinity="1"/>
    <geom name="pillar_l3_left" type="cylinder" size="0.06 0.15" pos="1.15 0.25 0.15" rgba="0.8 0.2 0.2 1.0" contype="1" conaffinity="1"/>
    <geom name="pillar_l3_right" type="cylinder" size="0.06 0.15" pos="1.15 -0.25 0.15" rgba="0.8 0.2 0.2 1.0" contype="1" conaffinity="1"/>
    <geom name="pillar_back" type="cylinder" size="0.08 0.15" pos="-0.75 0.0 0.15" rgba="0.8 0.2 0.2 1.0" contype="1" conaffinity="1"/>

    <!-- Staircase & Landing Platform -->
    <geom name="stair_step_1" type="box" size="0.06 0.40 0.0075" pos="1.40 0.0 0.0075" rgba="0.4 0.6 0.7 1.0" friction="1.5 0.01 0.0005" contype="1" conaffinity="1" group="3"/>
    <geom name="stair_step_2" type="box" size="0.06 0.40 0.015" pos="1.52 0.0 0.015" rgba="0.4 0.6 0.7 1.0" friction="1.5 0.01 0.0005" contype="1" conaffinity="1" group="3"/>
    <geom name="stair_step_3" type="box" size="0.06 0.40 0.0225" pos="1.64 0.0 0.0225" rgba="0.4 0.6 0.7 1.0" friction="1.5 0.01 0.0005" contype="1" conaffinity="1" group="3"/>
    <geom name="stair_platform" type="box" size="0.16 0.40 0.0225" pos="1.86 0.0 0.0225" rgba="0.4 0.6 0.7 1.0" friction="1.5 0.01 0.0005" contype="1" conaffinity="1" group="3"/>

    <body name="base_link" pos="0 0 0.095">
      <freejoint name="root"/>
      <site name="imu_site" pos="0 0 0" size="0.005" rgba="1 0 0 1"/>
      <!-- Sculpted Chibi Belly (ellipsoid) -->
      <geom name="base_body" type="ellipsoid" size="0.055 0.040 0.035" mass="0.320" material="duck_yellow"/>
      <!-- Sculpted Pelvis & Hip Flanks bridging body to hip joints -->
      <geom name="pelvis_geom" class="visual" type="ellipsoid" size="0.042 0.034 0.020" pos="0 0 -0.024" material="duck_yellow"/>
      <geom name="left_hip_flank" class="visual" type="ellipsoid" size="0.026 0.016 0.020" pos="0 0.026 -0.028" material="duck_yellow"/>
      <geom name="right_hip_flank" class="visual" type="ellipsoid" size="0.026 0.016 0.020" pos="0 -0.026 -0.028" material="duck_yellow"/>
      <!-- Visual duck tail -->
      <geom name="tail_geom" class="visual" type="ellipsoid" size="0.015 0.018 0.009" pos="-0.052 0 0.012" quat="0.9659 0 0.2588 0" material="duck_yellow"/>

      <!-- Head branch: Neck + Head (2 DOF) -->
      <body name="neck_link" pos="0.020 0 0.035">
        <joint name="head_yaw" type="hinge" axis="0 0 1" range="-1.57 1.57"/>
        <!-- Sculpted organic yellow duck neck -->
        <geom name="neck_geom" type="capsule" fromto="-0.002 0 0.000 0.004 0 0.016" size="0.017" mass="0.030" material="duck_yellow"/>

        <body name="head_link" pos="0.004 0 0.016">
          <joint name="head_pitch" type="hinge" axis="0 1 0" range="-0.52 0.78"/>
          <!-- Sculpted Head (rounded ellipsoid) -->
          <geom name="head_geom" type="ellipsoid" size="0.032 0.027 0.023" pos="0.008 0 0.016" mass="0.055" material="duck_yellow"/>
          <!-- Sculpted Duck Beak (curved duckbill ellipsoid) -->
          <geom name="beak_geom" type="ellipsoid" size="0.020 0.018 0.006" pos="0.044 0 0.011" mass="0.005" material="duck_orange"/>
          <!-- Eyes -->
          <geom name="left_eye" class="visual" type="sphere" size="0.004" pos="0.028 0.022 0.022" material="black"/>
          <geom name="right_eye" class="visual" type="sphere" size="0.004" pos="0.028 -0.022 0.022" material="black"/>
          <!-- Sparkle pupil highlights -->
          <geom name="left_eye_pupil" class="visual" type="sphere" size="0.0015" pos="0.031 0.0225 0.0235" material="white"/>
          <geom name="right_eye_pupil" class="visual" type="sphere" size="0.0015" pos="0.031 -0.0215 0.0235" material="white"/>
          <!-- Camera site & optical sensor -->
          <site name="camera_site" pos="0.040 0 0.022" size="0.003" rgba="0 1 0 0"/>
          <camera name="head_camera" pos="0.040 0 0.022" fovy="60" xyaxes="0 -1 0 0 0 1"/>
        </body>
      </body>

      <!-- Left Leg branch (3 DOF) -->
      <body name="left_hip_roll_link" pos="0 0.035 -0.035">
        <joint name="left_hip_roll" type="hinge" axis="1 0 0" range="-0.44 0.44"/>
        <!-- Sculpted Hip roll (cylinder along X) -->
        <geom name="left_hip_roll_geom" type="cylinder" size="0.018 0.015" pos="0 0.005 -0.006" zaxis="1 0 0" mass="0.050" material="servo_grey"/>

        <body name="left_thigh_link" pos="0 0.015 -0.020">
          <joint name="left_hip_pitch" type="hinge" axis="0 1 0" range="-0.87 0.87"/>
          <!-- Sculpted Thigh (smooth rounded capsule) -->
          <geom name="left_thigh_geom" type="capsule" fromto="0 0 -0.004 0 0 -0.028" size="0.014" mass="0.040" material="duck_yellow"/>

          <body name="left_shin_link" pos="0 0 -0.032">
            <joint name="left_knee_pitch" type="hinge" axis="0 1 0" range="0.0 1.48"/>
            <!-- Sculpted Shin (smooth rounded capsule) -->
            <geom name="left_shin_geom" type="capsule" fromto="0 0 -0.004 0 0 -0.028" size="0.012" mass="0.030" material="servo_grey"/>

            <body name="left_foot_link" pos="0 0 -0.032">
              <!-- Flat collision sole plate (flat bottom at Z = -0.008, high friction) -->
              <geom name="left_foot_geom" class="foot" pos="0.008 0 -0.004" mass="0.022" material="duck_orange" group="3"/>
              
              <!-- Sculpted Duck Foot Visuals -->
              <geom name="left_heel" class="visual" type="cylinder" size="0.012 0.003" pos="-0.008 0 -0.005" material="duck_orange"/>
              <geom name="left_ankle_bracket" class="visual" type="cylinder" size="0.013 0.004" pos="0 0 -0.002" material="servo_grey"/>
              
              <geom name="left_toe_mid" class="visual" type="capsule" fromto="-0.002 0 -0.0045 0.030 0 -0.0055" size="0.004" material="duck_orange"/>
              <geom name="left_claw_mid" class="visual" type="ellipsoid" size="0.004 0.0025 0.002" pos="0.033 0 -0.006" material="servo_grey"/>

              <geom name="left_toe_out" class="visual" type="capsule" fromto="-0.002 0.004 -0.0045 0.026 0.016 -0.0055" size="0.0038" material="duck_orange"/>
              <geom name="left_claw_out" class="visual" type="ellipsoid" size="0.0035 0.002 0.0018" pos="0.028 0.0175 -0.006" quat="0.976 0 0 0.216" material="servo_grey"/>

              <geom name="left_toe_in" class="visual" type="capsule" fromto="-0.002 -0.004 -0.0045 0.026 -0.016 -0.0055" size="0.0038" material="duck_orange"/>
              <geom name="left_claw_in" class="visual" type="ellipsoid" size="0.0035 0.002 0.0018" pos="0.028 -0.0175 -0.006" quat="0.976 0 0 -0.216" material="servo_grey"/>

              <geom name="left_web_left" class="visual" type="ellipsoid" size="0.015 0.007 0.0015" pos="0.014 0.008 -0.006" quat="0.991 0 0 0.13" material="web_orange"/>
              <geom name="left_web_right" class="visual" type="ellipsoid" size="0.015 0.007 0.0015" pos="0.014 -0.008 -0.006" quat="0.991 0 0 -0.13" material="web_orange"/>
              <geom name="left_instep" class="visual" type="ellipsoid" size="0.014 0.012 0.003" pos="0.006 0 -0.0035" material="duck_orange"/>

              <site name="left_foot_touch_site" pos="0.008 0 -0.004" size="0.026 0.021 0.004" type="box" rgba="0 1 1 0"/>
            </body>
          </body>
        </body>
      </body>

      <!-- Right Leg branch (3 DOF) -->
      <body name="right_hip_roll_link" pos="0 -0.035 -0.035">
        <joint name="right_hip_roll" type="hinge" axis="1 0 0" range="-0.44 0.44"/>
        <!-- Sculpted Hip roll (cylinder along X) -->
        <geom name="right_hip_roll_geom" type="cylinder" size="0.018 0.015" pos="0 -0.005 -0.006" zaxis="1 0 0" mass="0.050" material="servo_grey"/>

        <body name="right_thigh_link" pos="0 -0.015 -0.020">
          <joint name="right_hip_pitch" type="hinge" axis="0 1 0" range="-0.87 0.87"/>
          <!-- Sculpted Thigh (smooth rounded capsule) -->
          <geom name="right_thigh_geom" type="capsule" fromto="0 0 -0.004 0 0 -0.028" size="0.014" mass="0.040" material="duck_yellow"/>

          <body name="right_shin_link" pos="0 0 -0.032">
            <joint name="right_knee_pitch" type="hinge" axis="0 1 0" range="0.0 1.48"/>
            <!-- Sculpted Shin (smooth rounded capsule) -->
            <geom name="right_shin_geom" type="capsule" fromto="0 0 -0.004 0 0 -0.028" size="0.012" mass="0.030" material="servo_grey"/>

            <body name="right_foot_link" pos="0 0 -0.032">
              <!-- Flat collision sole plate (flat bottom at Z = -0.008, high friction) -->
              <geom name="right_foot_geom" class="foot" pos="0.008 0 -0.004" mass="0.022" material="duck_orange" group="3"/>

              <!-- Sculpted Duck Foot Visuals -->
              <geom name="right_heel" class="visual" type="cylinder" size="0.012 0.003" pos="-0.008 0 -0.005" material="duck_orange"/>
              <geom name="right_ankle_bracket" class="visual" type="cylinder" size="0.013 0.004" pos="0 0 -0.002" material="servo_grey"/>

              <geom name="right_toe_mid" class="visual" type="capsule" fromto="-0.002 0 -0.0045 0.030 0 -0.0055" size="0.004" material="duck_orange"/>
              <geom name="right_claw_mid" class="visual" type="ellipsoid" size="0.004 0.0025 0.002" pos="0.033 0 -0.006" material="servo_grey"/>

              <geom name="right_toe_out" class="visual" type="capsule" fromto="-0.002 -0.004 -0.0045 0.026 -0.016 -0.0055" size="0.0038" material="duck_orange"/>
              <geom name="right_claw_out" class="visual" type="ellipsoid" size="0.0035 0.002 0.0018" pos="0.028 -0.0175 -0.006" quat="0.976 0 0 -0.216" material="servo_grey"/>

              <geom name="right_toe_in" class="visual" type="capsule" fromto="-0.002 0.004 -0.0045 0.026 0.016 -0.0055" size="0.0038" material="duck_orange"/>
              <geom name="right_claw_in" class="visual" type="ellipsoid" size="0.0035 0.002 0.0018" pos="0.028 0.0175 -0.006" quat="0.976 0 0 0.216" material="servo_grey"/>

              <geom name="right_web_right" class="visual" type="ellipsoid" size="0.015 0.007 0.0015" pos="0.014 -0.008 -0.006" quat="0.991 0 0 -0.13" material="web_orange"/>
              <geom name="right_web_left" class="visual" type="ellipsoid" size="0.015 0.007 0.0015" pos="0.014 0.008 -0.006" quat="0.991 0 0 0.13" material="web_orange"/>
              <geom name="right_instep" class="visual" type="ellipsoid" size="0.014 0.012 0.003" pos="0.006 0 -0.0035" material="duck_orange"/>

              <site name="right_foot_touch_site" pos="0.008 0 -0.004" size="0.026 0.021 0.004" type="box" rgba="0 1 1 0"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="base_link" body2="neck_link"/>
    <exclude body1="neck_link" body2="head_link"/>
    <exclude body1="base_link" body2="left_hip_roll_link"/>
    <exclude body1="left_hip_roll_link" body2="left_thigh_link"/>
    <exclude body1="left_thigh_link" body2="left_shin_link"/>
    <exclude body1="left_shin_link" body2="left_foot_link"/>
    <exclude body1="base_link" body2="right_hip_roll_link"/>
    <exclude body1="right_hip_roll_link" body2="right_thigh_link"/>
    <exclude body1="right_thigh_link" body2="right_shin_link"/>
    <exclude body1="right_shin_link" body2="right_foot_link"/>
  </contact>

  <actuator>
    <motor name="head_yaw" joint="head_yaw" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="head_pitch" joint="head_pitch" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="left_hip_roll" joint="left_hip_roll" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="left_hip_pitch" joint="left_hip_pitch" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="left_knee_pitch" joint="left_knee_pitch" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="right_hip_roll" joint="right_hip_roll" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="right_hip_pitch" joint="right_hip_pitch" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
    <motor name="right_knee_pitch" joint="right_knee_pitch" gear="1" ctrlrange="-1.0 1.0" forcerange="-1.0 1.0"/>
  </actuator>

  <sensor>
    <accelerometer name="base_accel" site="imu_site"/>
    <gyro name="base_gyro" site="imu_site"/>
    <framequat name="base_quat" objtype="site" objname="imu_site"/>
    <touch name="left_foot_touch" site="left_foot_touch_site"/>
    <touch name="right_foot_touch" site="right_foot_touch_site"/>
    <jointpos name="head_yaw_pos" joint="head_yaw"/>
    <jointpos name="head_pitch_pos" joint="head_pitch"/>
    <jointpos name="left_hip_roll_pos" joint="left_hip_roll"/>
    <jointpos name="left_hip_pitch_pos" joint="left_hip_pitch"/>
    <jointpos name="left_knee_pitch_pos" joint="left_knee_pitch"/>
    <jointpos name="right_hip_roll_pos" joint="right_hip_roll"/>
    <jointpos name="right_hip_pitch_pos" joint="right_hip_pitch"/>
    <jointpos name="right_knee_pitch_pos" joint="right_knee_pitch"/>
    <jointvel name="head_yaw_vel" joint="head_yaw"/>
    <jointvel name="head_pitch_vel" joint="head_pitch"/>
    <jointvel name="left_hip_roll_vel" joint="left_hip_roll"/>
    <jointvel name="left_hip_pitch_vel" joint="left_hip_pitch"/>
    <jointvel name="left_knee_pitch_vel" joint="left_knee_pitch"/>
    <jointvel name="right_hip_roll_vel" joint="right_hip_roll"/>
    <jointvel name="right_hip_pitch_vel" joint="right_hip_pitch"/>
    <jointvel name="right_knee_pitch_vel" joint="right_knee_pitch"/>
  </sensor>
</mujoco>
